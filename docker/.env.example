# Copy to .env.prod on the server; chmod 600. Never commit the filled file.
COMPOSE_PROJECT_NAME=krayin
APP_ENV_FILE=.env.prod
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
DB_ROOT_PASSWORD_FILE=./secrets/db-root-password

APP_NAME="Krayin CRM"
APP_URL=https://crm.example.com
APP_KEY=
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=en
APP_CURRENCY=USD
APP_ADMIN_PATH=admin
APP_DEBUG=false
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
QUEUE_CONNECTION=database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=krayin
DB_USERNAME=krayin
DB_PASSWORD=
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Krayin CRM"
NOTIFICATION_DRIVER=polling

GREEN_API_ENABLED=false
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_WEBHOOK_TOKEN=
GREEN_API_DEFAULT_USER_ID=
GREEN_API_QUEUE=default
